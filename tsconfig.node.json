{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "server",
    "scripts",
    "supabase/functions",
    "vite.config.ts",
    "vite.calibration.config.ts",
    "vitest.config.ts",
    "vitest.perf.config.ts"
  ],
  // La calibración nocturna usa el alias @ de los motores y se empaqueta con Vite (3.1 del plan de B14),
  // así que se revisa con tsconfig.tests.json, que lo declara
  "exclude": ["scripts/calibration"]
}
