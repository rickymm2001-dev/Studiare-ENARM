{
  "name": "enarm-prototipo",
  "private": true,
  "version": "0.1.0",
  "description": "Prototipo funcional de una plataforma integral para preparar el ENARM",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,proxy --prefix-colors blue,magenta \"npm:dev:app\" \"npm:dev:proxy\"",
    "dev:app": "vite",
    "dev:proxy": "node --watch server/src/main.ts",
    "proxy": "node server/src/main.ts",
    "build": "tsc -b && vite build && node scripts/secrets.ts dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "check:dev": "node scripts/check-dev.ts",
    "e2e": "node scripts/playwright.ts test",
    "e2e-ui": "node scripts/playwright.ts test --ui",
    "e2e:install": "node scripts/playwright.ts install chromium",
    "screenshots": "node scripts/playwright.ts test --config playwright.screenshots.config.ts",
    "eval-ai": "node scripts/not-yet.ts eval-ai D",
    "demo-seed": "DEMO_SEED_DRY_RUN=1 vitest run tests/demo --silent=false",
    "demo-reset": "node scripts/demo-reset.ts",
    "bank:template": "node scripts/content/bank-template.ts",
    "recovery-report": "RECOVERY_REPORT=1 vitest run tests/recovery && prettier --write docs/recovery-report.md",
    "test:sql": "bash supabase/tests/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@hono/node-server": "2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "fzstd": "^0.1.1",
    "hono": "4.13.12",
    "lucide-react": "1.49.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "read-excel-file": "^9.3.12",
    "sql.js": "^1.14.2",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "5.4.2",
    "ulid": "3.0.2",
    "workbox-window": "7.4.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
