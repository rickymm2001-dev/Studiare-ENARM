{
  "name": "enarm-prototipo",
  "private": true,
  "version": "0.1.0",
  "description": "Prototipo funcional de una plataforma integral para preparar el ENARM",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,proxy --prefix-colors blue,magenta \"npm:dev:app\" \"npm:dev:proxy\"",
    "dev:app": "vite",
    "dev:proxy": "node --watch server/src/main.ts",
    "proxy": "node server/src/main.ts",
    "build": "tsc -b && vite build && node scripts/secrets.ts dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:dev": "node scripts/check-dev.ts",
    "e2e": "node scripts/playwright.ts test",
    "e2e-ui": "node scripts/playwright.ts test --ui",
    "e2e:install": "node scripts/playwright.ts install chromium",
    "screenshots": "node scripts/playwright.ts test --config playwright.screenshots.config.ts",
    "eval-ai": "node scripts/not-yet.ts eval-ai D",
    "demo-seed": "node scripts/not-yet.ts demo-seed B",
    "demo-reset": "node scripts/not-yet.ts demo-reset B"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hono/node-server": "2.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "hono": "4.13.12",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "ulid": "3.0.2",
    "workbox-window": "7.4.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
